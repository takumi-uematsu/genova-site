# Copy this file to `.env.local` (cp env.example .env.local) and fill in values.

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxxxxxxxxx

# --- Contact form addresses ---
# Must be on a domain you have verified in Resend.
# z-data.io is the production domain — keep noreply@ on it once DNS is set up.
CONTACT_FROM_EMAIL=noreply@z-data.io
# Comma-separated list. Auto-reply goes to the inquirer.
CONTACT_TO_EMAIL=takumi.uematsu@z-data.io,keita.ishida@z-data.io,kazuma.harigae@z-data.io

# --- Slack notification (optional) ---
# Incoming Webhook URL. Leave empty to disable.
SLACK_WEBHOOK_URL=

# --- Site ---
# Origin only (no trailing slash). The app itself is mounted at /company via
# Next.js basePath, so the corporate site lives at https://z-data.io/company.
NEXT_PUBLIC_SITE_URL=https://z-data.io
